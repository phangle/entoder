{
  "name": "entoder",
  "version": "0.1.4",
  "description": "CLI tool to upload photos from local directories to Ente Photos server",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "entoder": "./dist/entoder"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/entoder",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "commander": "^14.0.2",
    "exifreader": "^4.32.0",
    "fast-srp-hap": "^2.0.4",
    "libsodium-wrappers": "^0.7.15",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "rotating-file-stream": "^3.2.7",
    "thinbus-srp": "^2.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/libsodium-wrappers": "^0.7.14",
    "typescript": "^5.0.0"
  }
}